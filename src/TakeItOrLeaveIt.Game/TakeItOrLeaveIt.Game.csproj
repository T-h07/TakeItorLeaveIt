<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MelonLoader entry point and (future) Harmony integration with Schedule I.

    Two builds are produced from the same source, one per Unity scripting backend:
      net6.0  -> TakeItOrLeaveIt.Il2Cpp.dll  (default Steam branch, MelonLoader IL2CPP / .NET 6 runtime)
      net472  -> TakeItOrLeaveIt.Mono.dll    ("alternate" Steam beta branch, MelonLoader Mono runtime)

    Phase 00 references ONLY the redistributable LavaGang.MelonLoader NuGet package, so this project
    builds in CI without any proprietary game assemblies. Game types (Phases 02/03) come from locally exported
    reference assemblies set in local.build.props (never committed); see the conditional groups below.
  -->
  <PropertyGroup>
    <TargetFrameworks>net6.0;net472</TargetFrameworks>
    <RootNamespace>TakeItOrLeaveIt.Game</RootNamespace>
    <!-- NU1603: MelonLoader 0.7.3's nuspec pins Il2CppInterop 1.5.1-ci.845, which is not on nuget.org;
         NuGet resolves 1.5.1 instead. We only need MelonLoader/HarmonyX at compile time, so this is benign.
         NU1701: MelonLoader's net6.0 dependency group pulls in Microsoft.Bcl (a .NET Framework package);
         it is never shipped with our mod (the installed loader provides its own runtime). -->
    <NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>
    <!-- MelonLoader 0.7.3's transitive Microsoft.Extensions.* 10.x packages warn that net6.0 is untested.
         They are compile-time references only; the game uses the copies shipped with the installed loader. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <AssemblyName>TakeItOrLeaveIt.Il2Cpp</AssemblyName>
    <DefineConstants>$(DefineConstants);IL2CPP_BUILD</DefineConstants>
    <ModRuntime>Il2Cpp</ModRuntime>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <AssemblyName>TakeItOrLeaveIt.Mono</AssemblyName>
    <DefineConstants>$(DefineConstants);MONO_BUILD</DefineConstants>
    <ModRuntime>Mono</ModRuntime>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: MelonLoader (and its HarmonyX dependency) are provided by the installed loader. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TakeItOrLeaveIt.Core\TakeItOrLeaveIt.Core.csproj" />
  </ItemGroup>

  <!--
    Local game references (never committed): S1RefsDir in the git-ignored local.build.props points to
    assemblies exported from a real game install by tools/Export-BuildReferences.ps1. They are compile-time
    only (Private=false): nothing from the game or S1API is copied into our output. Without them (e.g. in CI)
    the mod builds without the game integrations and says so in its log and status report.

    GAME_PATCHES (Phase 03): Harmony hooks into the game's customer-contract code (Assembly-CSharp interop).
    PHONE_APP (Phase 02): the S1API phone app; needs S1API in addition.
    Both exist only in the IL2CPP build: no Mono references are exported.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0' And '$(S1RefsDir)' != '' And Exists('$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll')">
    <GamePatchesEnabled>true</GamePatchesEnabled>
    <DefineConstants>$(DefineConstants);GAME_PATCHES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GamePatchesEnabled)' == 'true' And Exists('$(S1RefsDir)\Mods\S1API.Il2Cpp.MelonLoader.dll')">
    <PhoneAppEnabled>true</PhoneAppEnabled>
    <DefineConstants>$(DefineConstants);PHONE_APP</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(GamePatchesEnabled)' == 'true'">
    <Reference Include="Il2Cppmscorlib" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2CppScheduleOne.Core" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Il2CppScheduleOne.Core.dll" Private="false" />
    <Reference Include="Il2CppFishNet.Runtime" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Il2CppFishNet.Runtime.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PhoneAppEnabled)' == 'true'">
    <Reference Include="S1API" HintPath="$(S1RefsDir)\Mods\S1API.Il2Cpp.MelonLoader.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(S1RefsDir)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(PhoneAppEnabled)' != 'true'">
    <Compile Remove="PhoneMenu\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(GamePatchesEnabled)' != 'true'">
    <Compile Remove="Sales\**" />
  </ItemGroup>

  <Target Name="ReportPhoneApp" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' == 'net6.0'">
    <Message Importance="high" Condition="'$(PhoneAppEnabled)' == 'true'" Text="TakeItOrLeaveIt: building WITH the S1API phone app (references: $(S1RefsDir))." />
    <Message Importance="high" Condition="'$(PhoneAppEnabled)' != 'true'" Text="TakeItOrLeaveIt: building WITHOUT the phone app (set S1RefsDir in local.build.props; see docs/BUILDING.md)." />
    <Message Importance="high" Condition="'$(GamePatchesEnabled)' == 'true'" Text="TakeItOrLeaveIt: building WITH the player and dealer sales game hooks." />
    <Message Importance="high" Condition="'$(GamePatchesEnabled)' != 'true'" Text="TakeItOrLeaveIt: building WITHOUT the player and dealer sales game hooks (no local game references)." />
  </Target>

  <!--
    Optional local deployment (DeployToGame=true in local.build.props).
    Copies only our own files: the mod DLL into <game>\Mods and the Core library into <game>\UserLibs.
    Nothing in the game installation is deleted or overwritten except previous copies of these files.
  -->
  <Target Name="DeployToScheduleOne" AfterTargets="Build"
          Condition="'$(DeployToGame)' == 'true' And '$(ScheduleOneGameDir)' != '' And '$(ModRuntime)' == '$(ScheduleOneRuntime)'">
    <Error Condition="!Exists('$(ScheduleOneGameDir)\Schedule I.exe')"
           Text="ScheduleOneGameDir '$(ScheduleOneGameDir)' does not contain 'Schedule I.exe'. Fix local.build.props." />
    <Error Condition="!Exists('$(ScheduleOneGameDir)\MelonLoader')"
           Text="MelonLoader is not installed in '$(ScheduleOneGameDir)'. Install it first (docs/INSTALLATION.md)." />
    <MakeDir Directories="$(ScheduleOneGameDir)\Mods;$(ScheduleOneGameDir)\UserLibs" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ScheduleOneGameDir)\Mods" />
    <Copy SourceFiles="$(OutDir)TakeItOrLeaveIt.Core.dll" DestinationFolder="$(ScheduleOneGameDir)\UserLibs" />
    <Message Importance="high" Text="Deployed $(TargetFileName) ($(ModRuntime)) to $(ScheduleOneGameDir)" />
  </Target>

</Project>
